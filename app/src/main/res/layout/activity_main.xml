<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_privacy_notice"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- Deepgram -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_deepgram"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/deepgram_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"
            android:layout_marginTop="6dp"/>

        <EditText
            android:id="@+id/deepgram_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/deepgram_key_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/deepgram_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"/>

            <Button
                android:id="@+id/deepgram_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear"/>
        </LinearLayout>

        <!-- Groq -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_groq"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:id="@+id/groq_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"
            android:layout_marginTop="6dp"/>

        <EditText
            android:id="@+id/groq_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/groq_key_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/groq_save_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"/>

            <Button
                android:id="@+id/groq_clear_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear"/>
        </LinearLayout>

        <EditText
            android:id="@+id/groq_model_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/groq_model_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/groq_model_help"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/groq_save_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_model"/>

        <!-- Azure -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_azure"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:id="@+id/azure_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"
            android:layout_marginTop="6dp"/>

        <EditText
            android:id="@+id/azure_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/azure_key_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/azure_save_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"/>

            <Button
                android:id="@+id/azure_clear_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear"/>
        </LinearLayout>

        <EditText
            android:id="@+id/azure_region_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/azure_region_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <EditText
            android:id="@+id/azure_voice_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/azure_voice_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <EditText
            android:id="@+id/azure_language_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/azure_language_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF90A4AE"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/azure_help"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/azure_save_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_azure_config"/>

        <!-- Device setup -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_device_setup"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_mic"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/device_mic_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"/>

        <Button
            android:id="@+id/device_mic_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_request_permission"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_assistant"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/device_assistant_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"/>

        <Button
            android:id="@+id/device_assistant_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_accessibility"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/device_accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"/>

        <Button
            android:id="@+id/device_accessibility_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_settings"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_restricted_note"
            android:textColor="#FFFFCC80"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_assistant_note"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/internet_note"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>

        <!-- Privacy -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_privacy"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_text"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
